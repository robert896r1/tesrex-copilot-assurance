{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tesrex.local/schemas/manual_evidence.schema.json",
  "title": "Tesrex Manual Evidence Bundle",
  "type": "object",
  "required": ["schema_version", "assessment_run_id", "tenant_id", "provided_by", "provided_at_utc", "items"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "assessment_run_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "provided_by": {"type": "string", "minLength": 1},
    "provided_at_utc": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["evidence_id", "control_ids", "evidence_type", "source_system", "artifact_path", "asserted_facts", "limitations"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "control_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_type": {
            "enum": ["manual_artifact", "screenshot", "report_export", "policy_snapshot", "audit_record", "raw_api_response", "permission_denial"]
          },
          "source_system": {"type": "string", "minLength": 1},
          "source_endpoint_or_ui_path": {"type": "string"},
          "artifact_path": {"type": "string", "minLength": 1},
          "asserted_facts": {"type": "object"},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "relevance_rating": {"enum": ["low", "medium", "high"]},
          "reliability_rating": {"enum": ["low", "medium", "high"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
